{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rag-kb",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  // 故意不声明 d1_databases / vectorize：D1 与 Vectorize 由 Worker 自己通过 Cloudflare REST API 创建和读写，
  // 所以控制台连上 GitHub 就能首次部署成功，不需要预先填任何资源 ID。
  // 也没有 ai 绑定：嵌入与生成都走第三方 OpenAI 兼容接口（API_URL + API_KEY）。
  "vars": {
    "ACCOUNT_ID": "",
    "DB_NAME": "rag-kb-db",
    "INDEX_NAME": "rag-kb-index",
    // 第三方模型接口：API_URL 填到 /v1 这一层（也可在控制台改），API_KEY 必须是 Secret
    "API_URL": "https://api.openai.com/v1",
    "API_TIMEOUT_MS": "60000",
    // 嵌入模型 ID 与维度必须与实际平台一致；换模型要同时改维度并重建索引
    "EMBEDDING_MODEL": "text-embedding-3-small",
    "EMBEDDING_DIMENSIONS": "1536",
    "EMBEDDING_METRIC": "cosine",
    "CHAT_MODEL": "gpt-4o-mini",
    "CHAT_MAX_TOKENS": "1500",
    "TOP_K": "6",
    "CHUNK_MAX_CHARS": "600",
    "CHUNK_OVERLAP_CHARS": "120",
    "MAX_DOC_CHARS": "200000",
    "MAX_CONTEXT_CHARS": "12000",
    "FETCH_TIMEOUT_MS": "8000",
    "FETCH_MAX_BYTES": "800000",
    "ALLOW_PRIVATE_URLS": "false"
  },
  "observability": {
    "enabled": true
  }
}
