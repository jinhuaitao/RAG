{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rag-kb",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  // 故意不声明 d1_databases / vectorize：D1 与 Vectorize 由 Worker 自己通过 Cloudflare REST API 创建和读写，
  // 所以控制台连上 GitHub 就能首次部署成功，不需要预先填任何资源 ID。
  //
  // ai 绑定是自动的：声明在这里，每次部署都跟着代码一起走，控制台不用手动加绑定，
  // 重新部署也不会把它冲掉。EMBEDDING_MODEL 填 @cf/ 开头的模型时，嵌入就走这个绑定。
  "ai": {
    "binding": "AI"
  },
  //
  // 同样不声明 vars：环境变量以控制台为唯一来源。
  // keep_vars = true 让 wrangler deploy 保留控制台里已有的变量（Secret 本来就不会被部署删除），
  // 所以 GitHub 每次触发重新部署都不会把 API_URL / API_KEY / ADMIN_TOKEN / 模型名冲回默认值。
  // 一个变量都没配时，src/lib/config.js 里的默认值兜底，服务照样能跑。
  "keep_vars": true,
  "observability": {
    "enabled": true
  }
}
